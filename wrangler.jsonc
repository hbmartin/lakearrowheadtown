{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lakearrowheadtown",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": ["*/10 * * * *"] },
  "preview_urls": false,
  "cache": { "enabled": true },
  "images": { "binding": "IMAGES" },
  "routes": [{ "pattern": "lakearrowhead.town", "custom_domain": true }],
  "vars": { "SITE_ORIGIN": "https://lakearrowhead.town", "ENVIRONMENT": "production" },
  "r2_buckets": [{ "binding": "SITE_BUCKET", "bucket_name": "lakearrowheadtown-content" }],
  "durable_objects": {
    "bindings": [{ "name": "PUBLISHER", "class_name": "DigestPublisher" }]
  },
  "exports": { "DigestPublisher": { "type": "durable-object", "storage": "sqlite" } },
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.svg"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png", "**/*.ico", "**/*.ttf", "**/*.woff2"], "fallthrough": true }
  ],
  "upload_source_maps": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "persist": true, "invocation_logs": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 } },
  "env": {
    "preview": {
      "name": "lakearrowheadtown-preview",
      "images": { "binding": "IMAGES" },
      "triggers": { "crons": ["*/10 * * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "persist": true, "invocation_logs": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 } },
      "routes": [],
      "vars": { "SITE_ORIGIN": "", "ENVIRONMENT": "preview" },
      "r2_buckets": [{ "binding": "SITE_BUCKET", "bucket_name": "lakearrowheadtown-content-preview" }],
      "durable_objects": {
        "bindings": [{ "name": "PUBLISHER", "class_name": "DigestPublisher" }]
      }
    }
  }
}
